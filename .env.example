# Discord bot token (required)
TOKEN=

# Discord user ID allowed to use admin commands
ADMIN_ID=123456789012345678

# Bot presence
BOT_STATUS_NAME=IL8

# Embed footer
WATERMARK=UA Hosting

# Default VPS resources
DEFAULT_RAM=2g
DEFAULT_CPU=1
DEFAULT_DISK=10G

# LXC storage path on Ubuntu
LXC_DIR=/var/lib/lxc
VPS_HOSTNAME=UA-Hosting

# Limits
SERVER_LIMIT=1
TOTAL_SERVER_LIMIT=50

# SQLite database
DATABASE_FILE=bot.db
